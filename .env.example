# ========================================
# CONFIGURATION BACKEND - RENDER
# ========================================
# Copiez ce fichier en .env et remplissez les valeurs

# Port du serveur
PORT=3001

# Environnement
NODE_ENV=development

# URL du Frontend (Vercel)
FRONTEND_URL=https://votre-app.vercel.app

# ========================================
# OPTION 1: Service Account JSON complet
# (Recommandé pour Render - une seule variable)
# ========================================
# Copiez tout le contenu de votre serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# ========================================
# OPTION 2: Variables séparées
# ========================================
FIREBASE_PROJECT_ID=votre-projet-id
FIREBASE_PRIVATE_KEY_ID=votre-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40votre-projet.iam.gserviceaccount.com
